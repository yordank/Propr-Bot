# ── Propr ──
PROPR_API_KEY=pk_live_xxxxxxxx
# празно = първият активен challenge
PROPR_ACCOUNT_ID=

# ── Таргет в Hyperliquid ──
TARGET=0xf97ad6704baec104d00b88e0c157e2b7b3a1ddd1

# ── Съотношение ──
# RATIO = MY_CAPITAL / TARGET_CAPITAL
#   5000   / 200000 = 0.025
#   100000 / 200000 = 0.5  (1:2)
#   200000 / 200000 = 1    (1:1)
# auto = startingBalance на challenge-а
MY_CAPITAL=auto
# число, или auto = текущият капитал на таргета
TARGET_CAPITAL=200000
# ако е попълнен, директно се ползва (напр. 0.025)
RATIO=

# ── Поведение ──
# '' = основни perps, xyz = акции/стоки (HIP-3)
DEXES=,xyz
POLL_MS=3000
MIN_ORDER_USD=11
MIN_CHANGE_PCT=5
COOLDOWN_MS=8000
MARGIN_SAFETY=0.85
# true = копира само нови позиции след старта
IGNORE_EXISTING_POSITIONS=false
COIN_BLACKLIST=

# true = само лог, без реални ордери
DRY_RUN=true
